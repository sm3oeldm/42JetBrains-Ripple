<idea-plugin>
    <id>com.ripple.plugin</id>
    <name>Ripple</name>
    <vendor>42 Abu Dhabi x JetBrains Hackathon Team</vendor>
    <description>In-editor execution-flow and state time machine.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Ripple" displayType="BALLOON"/>
        <localInspection language="JAVA"
                         shortName="RippleEdgeCase"
                         displayName="Ripple edge-case hypothesizer"
                         groupName="Ripple"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.ripple.inspection.EdgeCaseInspection"/>
        <codeInsight.lineMarkerProvider
                         language="JAVA"
                         implementationClass="com.ripple.gutter.CallGraphLineMarkerProvider"/>
        <!-- id must be literally "Ripple": BlastToolWindowFactory.TOOL_WINDOW_ID
             looks the window up by this string, and the README and demo script
             both call it "the Ripple tool window". -->
        <toolWindow id="Ripple"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowFind"
                    factoryClass="com.ripple.blast.ui.BlastToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- The one you demo: blast radius + recording + correlation, one keystroke.
             Ctrl+Alt+R has no binding in IDEA 2024.3's $default keymap. -->
        <action id="Ripple.Analyze"
                class="com.ripple.actions.RippleAnalyzeAction"
                text="Ripple: Analyze This Change"
                description="Show what this change can break, what no test protects, and record it running">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt R"/>
        </action>
        <action id="Ripple.GenerateTests"
                class="com.ripple.actions.GenerateTestsAction"
                text="Ripple: Write the Missing Tests"
                description="Write tests for the untested methods in the blast radius, using the values the recording observed">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Ripple.Analyze"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt W"/>
        </action>
        <action id="Ripple.Scrub"
                class="com.ripple.rewind.OpenScrubberAction"
                text="Ripple: Scrub Recording"
                description="Drag through the recorded run and watch the values change">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Ripple.Analyze"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
        </action>
        <action id="Ripple.TraceMethod"
                class="com.ripple.actions.TraceMethodAction"
                text="Trace This Method"
                description="Run this method under Ripple and show inline state trails">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <!-- NOT control alt T: that is "Surround With" in IDEA's own $default
                 keymap (verified in keymaps/$default.xml inside app-client.jar),
                 so on stage you get the Surround With popup instead of a trace.
                 control alt G has no binding in that keymap. The action is also
                 first in the editor context menu as a fallback route. -->
            <keyboard-shortcut keymap="$default" first-keystroke="control alt G"/>
        </action>
        <!-- Ripple.Diagnose is intentionally UNREGISTERED for submission: it is a
             development-only inspector and judges should not see it in the Tools
             menu. The class is kept in src (com.ripple.actions.RippleDiagnoseAction)
             so this block can be uncommented in seconds if the inspection
             misbehaves on the demo machine.
        <action id="Ripple.Diagnose"
                class="com.ripple.actions.RippleDiagnoseAction"
                text="Ripple: Diagnose Inspection"
                description="Temporary diagnostic for the hackathon">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
        -->
    </actions>
</idea-plugin>
